// ──────────────────────────────────────────────
// Hermes Car — Prisma Schema
// ──────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Vehicles ──────────────────────────────────
model Vehicle {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  year          Int
  make          String
  model         String
  trim          String?
  vin           String?
  mileage       Int?
  mileageUnit   String   @default("mi")
  exteriorColor String?
  interiorColor String?
  engine        String?
  transmission  String?
  drivetrain    String?
  price         String?
  status        String   @default("available") // available, sold, pending
  descriptionEn String?  @db.Text
  descriptionAr String?  @db.Text
  storyEn       String?  @db.Text
  storyAr       String?  @db.Text
  isFeatured    Boolean  @default(false)
  isPublished   Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images         VehicleImage[]
  documents      Document[]
  milestones     ProvenanceMilestone[]
  journalEntries JournalEntry[]
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  src       String
  alt       String?
  width     Int?
  height    Int?
  size      Int?
  isPrimary Boolean  @default(false)
  category  String   @default("exterior")
  sortOrder Int      @default(0)
  exifData  String?  @db.Text
  createdAt DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  filePath    String
  fileType    String
  fileSize    Int?
  category    String   @default("service")
  createdAt   DateTime @default(now())
}

model ProvenanceMilestone {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  title       String
  description String?  @db.Text
  icon        String   @default("purchase")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model JournalEntry {
  id          String   @id @default(cuid())
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  slug        String   @unique
  title       String
  contentEn   String?  @db.Text
  contentAr   String?  @db.Text
  excerpt     String?
  coverImage  String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  vehicleId String?
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  source    String   @default("contact-form")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── Users & Auth ──────────────────────────────
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  verified     Boolean   @default(false)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  phoneVerified Boolean  @default(false)
  phoneVerificationCode  String?
  phoneVerificationCodeExpiry DateTime?
  emailResendCount Int   @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  listingRequests ListingRequest[]
}

// ── Vehicle Listing Requests (public submissions) ──
model ListingRequest {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  status        String   @default("pending") // pending, approved, rejected
  name          String
  email         String
  phone         String?
  year          Int
  make          String
  model         String
  trim          String?
  mileage       Int?
  exteriorColor String?
  interiorColor String?
  engine        String?
  transmission  String?
  description   String?  @db.Text
  photoUrls     String?  @db.Text // JSON array of uploaded photo/video paths
  videoUrls     String?  @db.Text // JSON array of uploaded video paths
  notes         String?  @db.Text // admin notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}