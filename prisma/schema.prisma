// ──────────────────────────────────────────────
// Hermes Car — Prisma Schema
// ──────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  BUYER
  SELLER
  DEALER
  ADMINISTRATOR
  SUPER_ADMIN
}

enum DealerApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

// ── Vehicles ──────────────────────────────────
model Vehicle {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  year          Int
  make          String
  model         String
  trim          String?
  vin           String?
  mileage       Int?
  mileageUnit   String   @default("mi")
  exteriorColor String?
  interiorColor String?
  engine        String?
  transmission  String?
  drivetrain    String?
  price         String?
  status        String   @default("available") // available, sold, pending
  descriptionEn String?  @db.Text
  descriptionAr String?  @db.Text
  storyEn       String?  @db.Text
  storyAr       String?  @db.Text
  isFeatured    Boolean  @default(false)
  featuredUntil DateTime?
  category      String   @default("Other") // Modern, Classic, Vintage, EV, Other
  isPublished   Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images         VehicleImage[]
  documents      Document[]
  milestones     ProvenanceMilestone[]
  journalEntries JournalEntry[]
  favorites      Favorite[]
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  src       String
  alt       String?
  width     Int?
  height    Int?
  size      Int?
  isPrimary Boolean  @default(false)
  category  String   @default("exterior")
  sortOrder Int      @default(0)
  exifData  String?  @db.Text
  createdAt DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  filePath    String
  fileType    String
  fileSize    Int?
  category    String   @default("service")
  createdAt   DateTime @default(now())
}

model ProvenanceMilestone {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  title       String
  description String?  @db.Text
  icon        String   @default("purchase")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model JournalEntry {
  id          String   @id @default(cuid())
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  slug        String   @unique
  title       String
  author      String   @default("Fidelis Auto")
  contentEn   String?  @db.Text
  contentAr   String?  @db.Text
  excerpt     String?
  coverImage  String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  vehicleId String?
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  source    String   @default("contact-form")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── Users & Auth ──────────────────────────────
model User {
  id           String      @id @default(cuid())
  name         String
  firstName    String?
  lastName     String?
  email        String      @unique
  passwordHash String
  phone        String?
  country      String?
  city         String?
  role         AccountRole @default(BUYER)
  verified     Boolean     @default(false)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  phoneVerified Boolean  @default(false)
  phoneVerificationCode  String?
  phoneVerificationCodeExpiry DateTime?
  emailResendCount Int   @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  listingRequests ListingRequest[]
  favorites       Favorite[]
  sessions        AuthSession[]
  dealerProfile   DealerProfile?
  sentMessages       Message[]   @relation(name: "messageSender")
  receivedMessages   Message[]   @relation(name: "messageReceiver")
  conversationsAs1   Conversation[] @relation(name: "conversationParticipant1")
  conversationsAs2   Conversation[] @relation(name: "conversationParticipant2")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DealerProfile {
  id              String               @id @default(cuid())
  ownerId         String               @unique
  businessName    String
  contactPerson   String
  email           String
  phone           String
  address         String
  city            String
  country         String
  description     String               @db.Text
  website         String?
  logoUrl         String?
  approvalStatus  DealerApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  approvedById    String?
  moderationNotes String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([approvalStatus])
  @@index([country, city])
}

// ── Vehicle Listing Requests (public submissions) ──
model ListingRequest {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  status        String   @default("pending") // pending, approved, rejected
  name          String
  email         String
  phone         String?
  year          Int
  make          String
  model         String
  trim          String?
  mileage       Int?
  exteriorColor String?
  interiorColor String?
  engine        String?
  transmission  String?
  description   String?  @db.Text
  photoUrls     String?  @db.Text // JSON array of uploaded photo/video paths
  videoUrls     String?  @db.Text // JSON array of uploaded video paths
  city          String?
  state         String?
  country       String?
  zipCode       String?
  notes         String?  @db.Text // admin notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Newsletter Subscriptions ────────────────────
model NewsletterSubscription {
  id          String   @id @default(cuid())
  email       String   @unique
  subscribed  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ── Favorites ───────────────────────────────────
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
}

// ── Messaging ───────────────────────────────────
model Conversation {
  id              String    @id @default(cuid())
  participant1Id  String
  participant2Id  String
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())

  participant1 User      @relation(name: "conversationParticipant1", fields: [participant1Id], references: [id])
  participant2 User      @relation(name: "conversationParticipant2", fields: [participant2Id], references: [id])
  messages      Message[]

  @@unique([participant1Id, participant2Id])
}

model Message {
  id             String   @id @default(cuid())
  senderId       String
  receiverId     String
  conversationId String
  subject        String
  content        String   @db.Text
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  sender       User         @relation(name: "messageSender", fields: [senderId], references: [id])
  receiver     User         @relation(name: "messageReceiver", fields: [receiverId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}