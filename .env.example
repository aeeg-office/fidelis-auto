# Fidelis Auto — environment template (FID-008)
# Copy to .env (or /opt/fidelis-auto/.env on the VPS) and fill in real values.
# Never commit the real .env — only this template is versioned.

# PostgreSQL connection (shared Fidelis DB; user/host/db align with compose)
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/hermes_car

# Public site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fidelisauto.com

NODE_ENV=production

# Email delivery (optional)
RESEND_API_KEY=

# Admin bootstrap — Phase 1 temp credentials, rotate after first login
ADMIN_BOOTSTRAP=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
